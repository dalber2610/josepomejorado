# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - JOSEPO MEJORADO (FASE 7 HARDENED)
# Copia este archivo como '.env' y completa los valores correspondientes.
# NUNCA subas el archivo '.env' a tu repositorio Git.
# ==============================================================================

# Entorno: development, production, testing
FLASK_ENV=production
FLASK_DEBUG=false

# Claves criptográficas secretas (Generar con: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=cambiar_por_cadena_secreta_aleatoria_minimo_32_caracteres_hex
JWT_SECRET_KEY=cambiar_por_otra_cadena_secreta_para_firmar_tokens_jwt
WEBHOOK_SECRET=cambiar_por_clave_hmac_sha256_para_pasarela_de_pagos

# Base de datos primaria: PostgreSQL 16 + PostGIS 3.4 (Reemplazo de josepo_dev.db)
DATABASE_URL=postgresql://josepo_user:josepo_secure_password_2026@localhost:5432/josepo_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis & Flask-Limiter (Rate Limiting distribuido y WebSockets multinodo)
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Cabeceras CORS Restrictivas (Lista blanca de orígenes permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://josepo.ve,https://app.josepo.ve,https://admin.josepo.ve

# Proveedor de Mapas & Geocodificación (Solo en Backend, NUNCA en cliente móvil)
MAPQUEST_API_KEY=tu_api_key_de_mapquest_aqui

# Parámetros de Telemetría y Seguridad Anti-Spoofing GPS
MAX_SPEED_KMH_ANTI_SPOOF=180.0
TELEMETRY_DB_WRITE_INTERVAL_SEC=10

# Tasas de Cambio, Moneda & Cronjob de Automatización Cambiaria (Fase 7)
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
BCV_SECONDARY_API_URL=https://pydolarvenezuela-api.vercel.app/api/v1/dollar?page=bcv
CURRENCY_CRON_ENABLED=true
CURRENCY_CRON_INTERVAL_MINUTES=30

# Tarifas Base de Servicio (En centavos de Bolívar para evitar errores de coma flotante)
# 500.00 VES = 50000 centavos
BASE_RATE_VES_CENTS=50000
# 150.00 VES por KM = 15000 centavos
RATE_PER_KM_VES_CENTS=15000

# Parámetros del Servidor
PORT=5000
HOST=0.0.0.0
